# NASA POWER — No key required (free)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# OpenWeather — Free signup at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# GPM IMERG — Free registration at https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=your_username
EARTHDATA_PASSWORD=your_password

# CORS — Frontend URL(s)
ALLOWED_ORIGINS=https://junaidmsml.github.io,http://localhost:3000,http://localhost:8501
